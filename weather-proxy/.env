SECRET_KEY=change-me-session-secret
JWT_SECRET_KEY=change-me-jwt-secret
DATABASE_URL=sqlite:///weather.db
REDIS_URL=redis://localhost:6379/0

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30
